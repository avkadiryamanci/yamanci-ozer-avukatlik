{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yamanci-ozer-avukatlik",
  "compatibility_date": "2026-09-25",
  "main": "./worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
